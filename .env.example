# Servidor
PORT=3000

# Clave maestra para acceder al modo edición (NUNCA exponer al frontend)
MASTER_KEY=1234

# Secreto para firmar el token de sesión (24h)
JWT_SECRET=super_secret_this_is_key_24h_pwn

# Duración de la sesión (s=segundos, m=minutos, h=horas, d=días)
JWT_EXPIRES_IN=24h

# Directorios de persistencia (carpetas locales; montar como volumen del servidor)
DATA_DIR=./data
UPLOADS_DIR=./uploads
PUBLIC_DIR=./dist

# Vercel: token de acceso a Vercel Blob (lo provee Vercel al conectar un Blob Store).
# En Vercel la app usa Blob para persistir db.json y las fotos; en local se ignoran.
BLOB_READ_WRITE_TOKEN=
