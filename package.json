{
  "name": "mantenimiento-vehiculos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema interno de mantenimiento de vehículos (revisiones, fechas y respaldos fotográficos).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/backend/server.ts",
    "dev:client": "vite --config src/frontend/vite.config.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "preact": "^10.25.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
